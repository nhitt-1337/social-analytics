# Sao chép thành .env rồi điền giá trị thật. File .env đã nằm trong .gitignore.
#   cp .env.example .env
#
# Docker Compose tự đọc file này; Spring Boot đọc qua spring.config.import trong application.yaml.

# --- Social Login ---
# Tạo app tại https://developers.facebook.com/apps, lấy ở App settings -> Basic.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# App Facebook mới chỉ có sẵn public_profile; xin email chưa bật sẽ bị Invalid Scopes.
FACEBOOK_SCOPES=public_profile

# https://developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Database ---
DB_PASSWORD=root
DB_PORT=3306

# --- ActiveMQ ---
MQ_PORT=61616
MQ_CONSOLE_PORT=8161

# --- Job crawl ---
# Để false khi muốn tự bấm nút trên dashboard thay vì đợi lịch.
CRAWL_ENABLED=true
CRAWL_INTERVAL=PT1H
CRAWL_INITIAL_DELAY=PT1M
