<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mặc định XJC ánh xạ xs:dateTime thành XMLGregorianCalendar — kiểu cũ, dùng rất vướng.
  Binding này bảo XJC sinh ra java.time.LocalDateTime, để lớp sinh tự động dùng chung kiểu
  thời gian với phần còn lại của ứng dụng.
-->
<jaxb:bindings version="3.0"
               xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <jaxb:globalBindings>
        <jaxb:javaType name="java.time.LocalDateTime"
                       xmlType="xs:dateTime"
                       parseMethod="demo.socialanalytics.soap.SoapDateTimeAdapter.parse"
                       printMethod="demo.socialanalytics.soap.SoapDateTimeAdapter.print"/>
    </jaxb:globalBindings>
</jaxb:bindings>
